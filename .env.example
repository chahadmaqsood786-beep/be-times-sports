# ==============================================================================
# GORSY B2B MANUFACTURING - BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Port
PORT=3000

# Primary Destination Email for all customer inquiries
INQUIRY_DESTINATION_EMAIL=chahadmaqsood786@gmail.com

# ------------------------------------------------------------------------------
# RESEND TRANSACTIONAL EMAIL API CONFIGURATION
# ------------------------------------------------------------------------------
# 1. Sign up for a free Resend account at: https://resend.com
# 2. Generate an API Key under API Keys tab: https://resend.com/api-keys
# 3. Paste your key below (starts with "re_...")
# 4. For production domain sending, verify your custom domain in Resend DNS settings.
#    Until verified, Resend allows sending via "onboarding@resend.dev".
# ------------------------------------------------------------------------------
RESEND_API_KEY=

# Verified sender email address in Resend (default: onboarding@resend.dev)
RESEND_FROM_EMAIL=GORSY Export Desk <onboarding@resend.dev>
